{
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "uid": "tcping-alloy",
  "title": "tcping (Alloy)",
  "tags": [
    "tcping",
    "alloy",
    "prometheus"
  ],
  "description": "Probes tcping sent to Grafana Alloy with --alloy, read back from Prometheus.",
  "links": [
    {
      "title": "The same probes through InfluxDB",
      "type": "link",
      "url": "/d/tcping-influxdb",
      "icon": "external link",
      "tooltip": "Open the InfluxDB dashboard",
      "asDropdown": false,
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true,
      "tags": []
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "current": {}
      },
      {
        "name": "source",
        "label": "Source",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(tcping_probe_success, source)",
        "query": {
          "qryType": 1,
          "query": "label_values(tcping_probe_success, source)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "### Read from Prometheus, by way of Grafana Alloy\nEverything below is the OTLP metrics `tcping --alloy` sent to Alloy, which remote wrote them to Prometheus. A run that only uses `--influxdb` does not show up here: it is on the [tcping (InfluxDB)](/d/tcping-influxdb) dashboard."
      }
    },
    {
      "id": 1,
      "type": "row",
      "title": "Probes",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Round trip time",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "tcping_probe_rtt_milliseconds{source=~\"$source\"}",
          "legendFormat": "{{source}} {{protocol}} {{target}}:{{port}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "min",
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "The same probes taking the --alloy route into Prometheus."
    },
    {
      "id": 3,
      "type": "state-timeline",
      "title": "Probe result",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "tcping_probe_success{source=~\"$source\"}",
          "legendFormat": "{{source}} {{protocol}} {{target}}:{{port}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 90,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "no reply",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "reply",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "1 while the target answers, 0 for every probe that failed."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Packet loss",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "tcping_packet_loss_percent{source=~\"$source\"}",
          "legendFormat": "{{source}} {{protocol}} {{target}}:{{port}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "description": "One tile per target, from the running summary."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Successful and unsuccessful probes",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "tcping_probes_total{source=~\"$source\"}",
          "legendFormat": "{{source}} {{protocol}} {{target}}:{{port}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "The two counts the statistics block opens with, as they grow."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency min / average / max / mdev",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "tcping_rtt_milliseconds{source=~\"$source\"}",
          "legendFormat": "{{source}} {{protocol}} {{target}}:{{port}} {{stat}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "The running summary tcping sends every --stats-interval."
    },
    {
      "id": 7,
      "type": "row",
      "title": "Uptime and downtime",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Total uptime and downtime",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "tcping_uptime_seconds_total{source=~\"$source\"}",
          "legendFormat": "{{source}} {{protocol}} {{target}}:{{port}} uptime"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "tcping_downtime_seconds_total{source=~\"$source\"}",
          "legendFormat": "{{source}} {{protocol}} {{target}}:{{port}} downtime"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "The totals from the statistics block. They only move when the target changes state, so a target that has never flipped reads 0."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Length of each uptime and downtime streak",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "tcping_last_uptime_seconds{source=~\"$source\"}",
          "legendFormat": "{{source}} {{protocol}} {{target}}:{{port}} uptime"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "tcping_last_downtime_seconds{source=~\"$source\"}",
          "legendFormat": "{{source}} {{protocol}} {{target}}:{{port}} downtime"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Sent when a streak ends: how long the target had been up when it went down, and how long the outage lasted."
    },
    {
      "id": 10,
      "type": "table",
      "title": "Longest uptime and downtime",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "{__name__=~\"tcping_longest_(up|down)time_seconds|tcping_longest_(up|down)time_(start|end)_milliseconds\", source=~\"$source\"}",
          "legendFormat": "",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByLabels",
          "options": {
            "value": "__name__",
            "join": [
              "source",
              "protocol",
              "target",
              "port"
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "source": 0,
              "protocol": 1,
              "target": 2,
              "port": 3,
              "tcping_longest_uptime_seconds": 4,
              "tcping_longest_uptime_start_milliseconds": 5,
              "tcping_longest_uptime_end_milliseconds": 6,
              "tcping_longest_downtime_seconds": 7,
              "tcping_longest_downtime_start_milliseconds": 8,
              "tcping_longest_downtime_end_milliseconds": 9
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "tcping_longest_uptime_seconds"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "longest uptime"
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tcping_longest_uptime_start_milliseconds"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "uptime from"
              },
              {
                "id": "unit",
                "value": "time:MMM D HH:mm:ss"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tcping_longest_uptime_end_milliseconds"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "uptime to"
              },
              {
                "id": "unit",
                "value": "time:MMM D HH:mm:ss"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tcping_longest_downtime_seconds"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "longest downtime"
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tcping_longest_downtime_start_milliseconds"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "downtime from"
              },
              {
                "id": "unit",
                "value": "time:MMM D HH:mm:ss"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tcping_longest_downtime_end_milliseconds"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "downtime to"
              },
              {
                "id": "unit",
                "value": "time:MMM D HH:mm:ss"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "source"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 105
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "protocol"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 85
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "target"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 165
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "port"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 65
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "The longest the target stayed up and the longest it stayed down, and when each of those ran from and to. A streak is only known once it has ended, so a target that has not changed state yet has neither."
    },
