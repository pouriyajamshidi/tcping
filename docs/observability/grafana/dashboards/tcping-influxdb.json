                },
                "properties": [
                  {
                    "id": "displayName",
                    "value": "hostname retries"
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "hostname_changes"
                },
                "properties": [
                  {
                    "id": "displayName",
