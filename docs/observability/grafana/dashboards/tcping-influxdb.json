        {
          "id": 15,
          "type": "table",
          "title": "Resolved address",
          "gridPos": {
            "x": 12,
            "y": 52,
            "w": 12,
            "h": 9
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "influxdb",
                "uid": "${datasource}"
              },
              "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement =~ /^tcping_(tcp|udp|http)$/ and r._field == \"ip\")\n  |> filter(fn: (r) => r.source =~ /^${source:regex}$/)\n  |> last()\n  |> keep(columns: [\"source\", \"protocol\", \"target\", \"port\", \"_value\"])\n  |> group()\n  |> rename(columns: {_value: \"ip\"})\n  |> sort(columns: [\"source\", \"target\", \"port\"])"
            }
          ],
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": {},
                "indexByName": {
                  "source": 0,
                  "protocol": 1,
                  "target": 2,
                  "port": 3,
                  "ip": 4
                }
              }
            }
          ],
          "fieldConfig": {
            "defaults": {},
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "source"
                },
                "properties": [
