# gitignore
*.sh
.idea/
tcping
tcping.exe
.DS_Store
.vscode
.zed
*.code-workspace
patches/
*.db
.tool-versions
/build/
/release/
/result
tmp/
temp/

# secrets / credentials
# Unlike .gitignore, a pattern here only matches at the top of the context,
# so "**/" is what keeps these out of every folder.
**/.env
**/.env.*
**/*.key
**/*.pem
**/secrets/
**/credentials/
**/.aws/
**/.ssh/

# container files
Dockerfile
